DJANGO_SECRET_KEY=replace-this-with-a-unique-secret-key-of-at-least-50-random-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
MONETA_TRUST_X_FORWARDED_FOR=0
MONETA_TRUSTED_PROXY_CIDRS=
MONETA_WEB_SETUP_ENABLED=0
MONETA_SETUP_TOKEN=
MONETA_LOGIN_MAX_ATTEMPTS=10
MONETA_LOGIN_LOCKOUT_SECONDS=900
MONETA_RECURRING_BATCH_SIZE=100
MONETA_RECURRING_MAX_CYCLES=24
MONETA_FECI_ANNUAL_RATE_PERCENT=1.00
SAAS_EDITION=lite
SAAS_APP_NAME=Moneta Lite
SAAS_APP_DESCRIPTION_ES=Moneta - finanzas personales, contabilidad y flujo de caja.
SAAS_APP_DESCRIPTION_EN=Moneta - personal finance, accounting and cash flow.
SAAS_APP_FAVICON=img/moneta_favicon.png
SAAS_APP_OG_IMAGE=img/moneta_logo.png
SAAS_APP_LOGO_LIGHT=img/moneta_icon_light.png
SAAS_APP_LOGO_DARK=img/moneta_icon_dark.png
SAAS_LOGIN_TITLE_ES=Ingresar
SAAS_LOGIN_TITLE_EN=Sign in
SAAS_LOGIN_DESCRIPTION_ES=Registra tus finanzas, deuda y capital desde un solo panel.
SAAS_LOGIN_DESCRIPTION_EN=Track finance, debt and capital from a single workspace.

# Para PostgreSQL en produccion:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=moneta
# DB_USER=moneta
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# Cache backend (importante con multiples workers Gunicorn):
# DJANGO_CACHE_BACKEND=locmem   <- default en DEBUG=1, single-process
# DJANGO_CACHE_BACKEND=file     <- default seguro en DEBUG=0, sin tabla adicional
# DJANGO_CACHE_BACKEND=db       <- multi-worker (requiere: python manage.py createcachetable)
# DJANGO_CACHE_BACKEND=redis    <- recomendado en produccion con alta carga
# DJANGO_CACHE_REDIS_URL=redis://127.0.0.1:6379/1

# MONETA_TRUST_X_FORWARDED_FOR=1 requiere tambien MONETA_TRUSTED_PROXY_CIDRS.
# Ejemplo privado: MONETA_TRUSTED_PROXY_CIDRS=10.0.0.10/32,fd00::10/128
# El setup web esta deshabilitado por defecto. Si se habilita temporalmente,
# MONETA_SETUP_TOKEN debe ser aleatorio, secreto y tener al menos 32 caracteres.

# Para produccion:
# - Genera un DJANGO_SECRET_KEY unico y privado de 50+ caracteres.
# - Conserva DJANGO_DEBUG=0.
# - Usa DJANGO_ALLOWED_HOSTS con tu dominio/IP real.
# - Usa DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.com.
# - MantÃ©n DJANGO_SECURE_SSL_REDIRECT=1 y DJANGO_SECURE_HSTS_SECONDS=31536000 solo si ya tienes HTTPS activo.
# - Con DJANGO_CACHE_BACKEND=db ejecuta: python manage.py createcachetable

